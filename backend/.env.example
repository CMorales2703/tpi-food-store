# Copiar este archivo como .env y reemplazar los marcadores.
# El .env NO se entrega ni se sube al repositorio (está en .gitignore).

# --- Base de datos: usuario:CONTRASEÑA@host:puerto/base ---
DATABASE_URL=postgresql+psycopg://postgres:TU_CONTRASEÑA@localhost:5432/food_store

# --- JWT ---
# Generar una clave propia, por ejemplo con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REEMPLAZAR_POR_UNA_CLAVE_SECRETA_LARGA
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Cookie (en producción con HTTPS: COOKIE_SECURE=true) ---
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- CORS: origen del frontend (separar con comas si hay más de uno) ---
CORS_ORIGINS=http://localhost:5173

# --- Usuario administrador inicial (lo crea seed.py) ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@foodstore.com
ADMIN_FULL_NAME=Administrador
ADMIN_PASSWORD=REEMPLAZAR_CLAVE_ADMIN
