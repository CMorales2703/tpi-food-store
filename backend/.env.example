# Copiar este archivo como .env y completar los valores.
# El .env NO se entrega ni se sube al repositorio (está en .gitignore).

# --- Base de datos ---
# PostgreSQL: postgresql://USUARIO:CONTRASEÑA@localhost:5432/foodstore_db
#   (con PostgreSQL de Homebrew en macOS: postgresql://TU_USUARIO_DE_MAC@localhost:5432/foodstore_db)
DATABASE_URL=postgresql://user:pass@localhost:5432/foodstore_db
# Para una prueba rápida sin PostgreSQL se puede usar SQLite:
# DATABASE_URL=sqlite:///./foodstore.db

# --- JWT ---
# Mínimo 32 caracteres (si es más corta, la app no arranca).
# Para generar una propia: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres
ALGORITHM=HS256
# Expiración del token y de la cookie, en minutos
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- CORS: origen del frontend (Vite) ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Opcionales (tienen valor por defecto) ---
# En producción con HTTPS: COOKIE_SECURE=true
# COOKIE_SECURE=false
# COOKIE_SAMESITE=lax
# SQL_ECHO=false
